# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=osap
DB_PASSWORD=osap
DB_NAME=osap_storage
DB_POOL_SIZE=10

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# URL base publica usada para construir URLs de descarga propias
PUBLIC_BASE_URL=http://localhost:8000

# Directorio temporal para descargas en curso
TEMP_DIR=data/tmp

# Proveedor local por defecto (creado automaticamente al arrancar si no hay ninguno)
BOOTSTRAP_DEFAULT_PROVIDER=true
DEFAULT_LOCAL_STORAGE_ROOT=data/files

# Atribucion asistida por IA (Gemini). La key va SOLO en el entorno del servicio
# (400/600, p.ej. /etc/openmusicrepository/osap-storage.env); nunca en el repo ni en la BD.
# Sin key, el endpoint /api/admin/work-person-ai responde 503 AI_NOT_CONFIGURED.
# Modelo por defecto: gemini-flash-lite-latest (rapido y estable). Los "2.5-flash" ya no
# estan disponibles para claves nuevas; si se cambia, usar un modelo lite/flash vigente.
OSAP_STORAGE_GEMINI_API_KEY=
OSAP_STORAGE_GEMINI_MODEL=gemini-flash-lite-latest
