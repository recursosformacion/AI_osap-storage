# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=osap
DB_PASSWORD=osap
DB_NAME=osap_storage
DB_POOL_SIZE=10

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# URL base publica usada para construir URLs de descarga propias
PUBLIC_BASE_URL=http://localhost:8000

# Directorio temporal para descargas en curso
TEMP_DIR=data/tmp

# Proveedor local por defecto (creado automaticamente al arrancar si no hay ninguno)
BOOTSTRAP_DEFAULT_PROVIDER=true
DEFAULT_LOCAL_STORAGE_ROOT=data/files
