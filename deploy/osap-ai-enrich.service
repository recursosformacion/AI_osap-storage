[Unit]
Description=OSAP AI enrichment (persons and works)
After=network.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=ocw
Group=ocw
WorkingDirectory=/home/ocw/openmusicrepository.com/osap-storage
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ocw/openmusicrepository.com/osap-storage/.venv/bin/python scripts/ai_enrich_prod.py --persons-start 2 --works-start 723 --sleep 10 --pause-hours 24
Restart=on-failure
RestartSec=60
Nice=19
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=2G

[Install]
WantedBy=multi-user.target


