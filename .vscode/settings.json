{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.diagnosticMode": "openFiles",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.useImportHeuristics": true,
  "python.analysis.exclude": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/data/**",
    "**/devdata/**",
    "**/__pycache__/**"
  ],
  "ruff.lint.enable": true,
  "ruff.format.enable": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "cSpell.language": "en,es",
  "cSpell.ignorePaths": [
    "**/.venv/**",
    "**/data/**",
    "**/devdata/**",
    "**/node_modules/**",
    "**/.git/**",
    "**/__pycache__/**"
  ],
  "cSpell.words": [
    "aiomysql",
    "boto3",
    "cloudflare",
    "cloudflare_r2",
    "cdn",
    "r2",
    "minio",
    "httpx",
    "uvicorn",
    "fastapi",
    "pydantic",
    "pydantic_settings",
    "ruff",
    "pytest",
    "pytest_asyncio",
    "mariadb",
    "mysql",
    "mysqldump",
    "osap",
    "pdmx",
    "musicxml",
    "mxl",
    "sha",
    "sha256",
    "presigned",
    "archive",
    "archives",
    "archive_entry",
    "archive_entries",
    "storage_location",
    "storage_locations",
    "storage_provider",
    "storage_providers",
    "download_job",
    "download_jobs",
    "import_source",
    "import_sources",
    "work_key",
    "relative_path",
    "logical_id",
    "mime_type",
    "object_key",
    "local_disk",
    "http_remote",
    "google_drive",
    "serve_directly",
    "path_prefix",
    "public_url",
    "work",
    "works",
    "resource",
    "resources",
    "materialize",
    "materializer",
    "importer",
    "mirror",
    "verify",
    "resolve",
    "resolver",
    "register",
    "download",
    "downloads",
    "search",
